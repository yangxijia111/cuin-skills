# ============================================================
# cuin-skills — .gitignore
# 原则：只收录 Skill 源文件（Markdown）。
#      打包产物、构建产物、密钥凭证、本地配置、日志缓存一律不入库。
# ============================================================

# ---------- 安全红线：密钥与凭证（绝不入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
secrets.json
*-credentials.*
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.aws/
.ssh/
.npmrc
.pypirc
.netrc

# ---------- Skill 打包 / 构建产物 ----------
# skill 打包生成的 zip 属于分发产物，可由源文件随时重新生成，不入库
*.zip
*.skill
*.tar
*.tar.gz
*.tgz

# ---------- Skill 运行期产物 ----------
*.log
logs/
.cache/
__pycache__/
*.py[cod]
node_modules/
dist/
build/
*.tmp
*.bak
*.swp
*~

# ---------- 操作系统 ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- IDE / 编辑器本地配置 ----------
.vscode/
.idea/
*.code-workspace
.claude/settings.local.json

# ---------- Agent 工作区本地数据（记忆、会话、缓存） ----------
.workbuddy/
.claude/
